<div class="plane-cube-intersection">
	<div class="visualization-layout">
		<div class="viewport"></div>

		<div class="controls">
			<label>
				<span class="control-header">
					<span id="plane-offset-label">Plane Offset</span>

					<output
						class="plane-offset-value"
						for="plane-offset"
						aria-hidden="true"
					>
						0.00
					</output>
				</span>

				<input
					id="plane-offset"
					class="plane-offset"
					type="range"
					min="-0.87"
					max="0.87"
					step="0.01"
					value="0"
					aria-labelledby="plane-offset-label"
				/>
			</label>

			<label>
				<span class="control-header">
					<span id="plane-azimuth-label">Azimuth</span>

					<output
						class="plane-azimuth-value"
						for="plane-azimuth"
						aria-hidden="true"
					>
						180°
					</output>
				</span>

				<input
					id="plane-azimuth"
					class="plane-azimuth"
					type="range"
					min="-180"
					max="180"
					step="1"
					value="180"
					aria-labelledby="plane-azimuth-label"
				/>
			</label>

			<label>
				<span class="control-header">
					<span id="plane-elevation-label">Elevation</span>

					<output
						class="plane-elevation-value"
						for="plane-elevation"
						aria-hidden="true"
					>
						45°
					</output>
				</span>

				<input
					id="plane-elevation"
					class="plane-elevation"
					type="range"
					min="-90"
					max="90"
					step="1"
					value="45"
					aria-labelledby="plane-elevation-label"
				/>
			</label>

			<button type="button" class="reset-plane"> Reset Plane </button>

			<button type="button" class="reset-camera"> Reset Camera </button>

			<output class="intersection-status" tabindex="0" aria-live="off"
			></output>
		</div>
	</div>

	<p id="plane-cube-instructions" class="viewport-instructions">
		<strong>3D controls:</strong> Use the mouse to rotate, pan, and zoom the camera.
		Alternatively, click or Tab to the viewport and use the arrow keys to rotate,
		and + or - to zoom. Reset Camera restores the original view.
	</p>
</div>

<style>
	.plane-cube-intersection {
		width: 100%;
		max-width: var(--width-content);
	}

	.visualization-layout {
		display: flex;
		align-items: flex-start;
		gap: 24px;
	}

	.viewport {
		width: 640px;
		aspect-ratio: 4 / 3;
		overflow: hidden;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-medium);
		background: var(--color-bg);
	}

	.viewport canvas {
		display: block;
		width: 100%;
		height: 100%;
	}

	.viewport:focus-within {
		outline: 2px solid var(--color-accent-blue);
		outline-offset: 4px;
	}

	.viewport-instructions {
		margin: 0.75rem 0;
		padding: 0 0 0.75rem;

		border-bottom: 1px solid var(--color-border);

		color: var(--color-text-secondary);
		font-size: 0.9rem;
		line-height: 1.6;
	}

	.controls {
		display: flex;
		flex-direction: column;
		gap: 16px;
		min-width: 220px;
		padding: 1rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-medium);
		background: var(--color-panel);
		color: var(--color-text-secondary);
	}

	.controls label {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.control-header {
		display: flex;
		justify-content: space-between;
		gap: 12px;
		color: var(--color-text);
	}

	.controls input[type="range"] {
		width: 100%;
		margin: 0;
		accent-color: var(--color-accent-blue);
		cursor: pointer;
	}

	.controls button {
		border: 1px solid var(--color-border);
		border-radius: var(--radius-small);
		padding: 0.55rem 0.75rem;
		background: var(--color-panel);
		color: var(--color-text);
		font: inherit;
		cursor: pointer;
		transition:
			background 0.15s ease,
			border-color 0.15s ease,
			color 0.15s ease;
	}

	.controls button:hover {
		background: var(--color-panel-hover);
		border-color: var(--color-border-strong);
		color: var(--color-accent-gold);
	}

	.controls button:focus-visible {
		outline: 2px solid var(--color-accent-blue);
		outline-offset: 2px;
	}

	.intersection-status {
		padding-top: 0.25rem;
		color: var(--color-text-secondary);
		font-size: 0.95rem;
	}

	.intersection-status:focus-visible {
		outline: 2px solid var(--color-accent-blue);
		outline-offset: 4px;
		border-radius: var(--radius-small);
	}
</style>

<script>
	import "../scripts/visualizations/planeCubeIntersectionBasic.js";
</script>

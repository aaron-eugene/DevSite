<div class="plane-cube-intersection">
	<div class="viewport"></div>

	<div class="controls">
		<label>
			<span class="control-header">
				<span>Plane Offset</span>
				<span class="plane-offset-value">0.00</span>
			</span>

			<input
				class="plane-offset"
				type="range"
				min="-0.87"
				max="0.87"
				step="0.01"
				value="0"
			/>
		</label>

		<label>
			<span class="control-header">
				<span>Azimuth</span>
				<span class="plane-azimuth-value">180°</span>
			</span>

			<input
				class="plane-azimuth"
				type="range"
				min="-180"
				max="180"
				step="1"
				value="180"
			/>
		</label>

		<label>
			<span class="control-header">
				<span>Elevation</span>
				<span class="plane-elevation-value">45°</span>
			</span>

			<input
				class="plane-elevation"
				type="range"
				min="-90"
				max="90"
				step="1"
				value="45"
			/>
		</label>

		<button class="reset-plane"> Reset Plane </button>

		<button class="reset-camera"> Reset Camera </button>

		<div class="intersection-status"></div>
	</div>

<div class="surface-voxel-grid">
	<div class="visualization-layout">
		<div class="viewport"></div>

		<div class="controls">
			<label>
				<span class="control-header">
					<span id="surface-variation-label">Surface Variation</span>
					<output
						class="surface-variation-value"
						for="surface-variation"
						aria-hidden="true"
					>
					</output>
				</span>

				<input
					id="surface-variation"
					class="surface-variation"
					type="range"
					min="-10.0"
					max="10.0"
					step="0.5"
					value="0"
					aria-labelledby="surface-variation-label"
				/>
			</label>

			<button type="button" class="toggle-surface">
				Toggle Surface
			</button>

			<button type="button" class="toggle-surface-voxels">
				Toggle Surface Voxels
			</button>

			<button type="button" class="toggle-voxel-grid">
				Toggle Voxel Lattice
			</button>

			<button type="button" class="reset-camera"> Reset Camera </button>

			<output
				class="num-surface-voxels"
				aria-live="polite"
				aria-atomic="true"
			>
			</output>
		</div>
	</div>

	<p id="surface-grid-instructions" class="viewport-instructions">
		<strong>3D controls:</strong> Use the mouse to rotate, pan, and zoom the camera.
		Alternatively, click or Tab to the viewport and use the arrow keys to rotate,
		and + or - to zoom. Reset Camera restores the original view.
	</p>
</div>

<style>
	.surface-voxel-grid {
		width: 100%;
		max-width: var(--width-content);
	}

	.visualization-layout {
		display: flex;
		align-items: flex-start;
		gap: 24px;
	}

	.viewport {
		width: 640px;
		aspect-ratio: 4 / 3;
		overflow: hidden;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-medium);
		background: var(--color-bg);
	}

	.viewport canvas {
		display: block;
		width: 100%;
		height: 100%;
	}

	.viewport:focus-within {
		outline: 2px solid var(--color-accent-blue);
		outline-offset: 4px;
	}

	.viewport-instructions {
		margin: 0.75rem 0;
		padding: 0 0 0.75rem;

		border-bottom: 1px solid var(--color-border);

		color: var(--color-text-secondary);
		font-size: 0.9rem;
		line-height: 1.6;
	}

	.controls {
		display: flex;
		flex-direction: column;
		gap: 16px;
		min-width: 220px;
		padding: 1rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-medium);
		background: var(--color-panel);
		color: var(--color-text-secondary);
	}

	.controls label {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.control-header {
		display: flex;
		justify-content: space-between;
		gap: 12px;
		color: var(--color-text);
	}

	.controls input[type="range"] {
		width: 100%;
		margin: 0;
		accent-color: var(--color-accent-blue);
		cursor: pointer;
	}

	.controls button {
		border: 1px solid var(--color-border);
		border-radius: var(--radius-small);
		padding: 0.55rem 0.75rem;
		background: var(--color-panel);
		color: var(--color-text);
		font: inherit;
		cursor: pointer;
		transition:
			background 0.15s ease,
			border-color 0.15s ease,
			color 0.15s ease;
	}

	.controls button:hover {
		background: var(--color-panel-hover);
		border-color: var(--color-border-strong);
		color: var(--color-accent-gold);
	}

	.controls button:focus-visible {
		outline: 2px solid var(--color-accent-blue);
		outline-offset: 2px;
	}

	.num-surface-voxels {
		padding-top: 0.25rem;
		color: var(--color-text-secondary);
		font-size: 0.95rem;
	}

	@media (max-width: 650px) {
		.visualization-layout {
			flex-direction: column;
		}

		.viewport {
			box-sizing: border-box;
			width: 100%;
			flex: none;
		}

		.controls {
			box-sizing: border-box;
			width: 100%;
			min-width: 0;
		}
	}
</style>

<script>
	import "../scripts/visualizations/surfaceVoxelGridBasic.js";
</script>

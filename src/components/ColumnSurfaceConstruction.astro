<div class="column-surface-construction">
	<div class="visualization-layout">
		<div class="viewport"></div>

		<div class="controls">
			<label>
				<span class="control-header">
					<span id="noise-position-label">Noise Position</span>

					<output
						class="noise-position-value"
						for="noise-position"
						aria-hidden="true"
					>
						0.00
					</output>
				</span>

				<input
					id="noise-position"
					class="noise-position"
					type="range"
					min="-20.0"
					max="20.0"
					step="0.25"
					value="0"
					aria-labelledby="noise-position-label"
				/>
			</label>

			<label class="visibility-control">
				<input
					class="toggle-original-surface"
					type="checkbox"
					checked
				/>
				<span>Original Surface</span>
			</label>

			<label class="visibility-control">
				<input class="toggle-corner-samples" type="checkbox" />
				<span>Corner Samples</span>
			</label>

			<label class="visibility-control">
				<input class="toggle-bicubic-patch" type="checkbox" />
				<span>Bicubic Patch</span>
			</label>

			<label class="visibility-control">
				<input class="toggle-direct-tangent" type="checkbox" checked />
				<span
					class="layer-swatch direct-tangent-swatch"
					aria-hidden="true"></span>
				<span>Direct Tangent</span>
			</label>

			<label class="visibility-control">
				<input class="toggle-hermite-tangent" type="checkbox" checked />
				<span
					class="layer-swatch hermite-tangent-swatch"
					aria-hidden="true"></span>
				<span>Hermite Tangent</span>
			</label>

			<button type="button" class="reset-camera"> Reset Camera </button>

			<div
				class="tangent-samples"
				tabindex="0"
				aria-label="Tangent sample comparison"
			>
				<div class="tangent-sample-header">
					<span></span>
					<span>y</span>
					<span>Slope</span>
				</div>

				<div class="tangent-sample-row">
					<span class="tangent-sample-label">
						<span
							class="layer-swatch direct-tangent-swatch"
							aria-hidden="true"
						>
						</span>
						<span>Direct</span>
					</span>

					<span class="direct-tangent-height"> 0.00 </span>

					<span class="direct-tangent-slope"> (0.00, 0.00) </span>
				</div>

				<div class="tangent-sample-row">
					<span class="tangent-sample-label">
						<span
							class="layer-swatch hermite-tangent-swatch"
							aria-hidden="true"
						>
						</span>
						<span>Hermite</span>
					</span>

					<span class="hermite-tangent-height"> 0.00 </span>

					<span class="hermite-tangent-slope"> (0.00, 0.00) </span>
				</div>
			</div>
		</div>
	</div>

	<p id="column-surface-instructions" class="viewport-instructions">
		<strong>3D controls:</strong> Use the mouse to rotate, pan, and zoom the camera.
		Alternatively, click or Tab to the viewport and use the arrow keys to rotate,
		and + or - to zoom. Reset Camera restores the original view.
	</p>
</div>

<style>
	.column-surface-construction {
		width: 100%;
		max-width: var(--width-content);
	}

	.visualization-layout {
		display: flex;
		align-items: flex-start;
		gap: 24px;
	}

	.viewport {
		width: 640px;
		aspect-ratio: 4 / 3;
		overflow: hidden;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-medium);
		background: var(--color-bg);
	}

	.viewport canvas {
		display: block;
		width: 100%;
		height: 100%;
	}

	.viewport:focus-within {
		outline: 2px solid var(--color-accent-blue);
		outline-offset: 4px;
	}

	.viewport-instructions {
		margin: 0.75rem 0;
		padding: 0 0 0.75rem;

		border-bottom: 1px solid var(--color-border);

		color: var(--color-text-secondary);
		font-size: 0.9rem;
		line-height: 1.6;
	}

	.controls {
		display: flex;
		flex-direction: column;
		gap: 16px;
		min-width: 220px;
		padding: 1rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-medium);
		background: var(--color-panel);
		color: var(--color-text-secondary);
	}

	.control-header {
		display: flex;
		justify-content: space-between;
		gap: 12px;
		color: var(--color-text);
	}

	.controls input[type="range"] {
		width: 100%;
		margin: 0;
		accent-color: var(--color-accent-blue);
		cursor: pointer;
	}

	.controls button {
		border: 1px solid var(--color-border);
		border-radius: var(--radius-small);
		padding: 0.55rem 0.75rem;
		background: var(--color-panel);
		color: var(--color-text);
		font: inherit;
		cursor: pointer;
		transition:
			background 0.15s ease,
			border-color 0.15s ease,
			color 0.15s ease;
	}

	.controls button:hover {
		background: var(--color-panel-hover);
		border-color: var(--color-border-strong);
		color: var(--color-accent-gold);
	}

	.controls button:focus-visible {
		outline: 2px solid var(--color-accent-blue);
		outline-offset: 2px;
	}

	.controls > label:not(.visibility-control) {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.visibility-control {
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 8px;
		color: var(--color-text);
		cursor: pointer;
	}

	.visibility-control input {
		margin: 0;
		accent-color: var(--color-accent-blue);
	}

	.tangent-samples {
		display: grid;
		grid-template-columns: auto auto auto;
		column-gap: 10px;
		row-gap: 6px;
		align-items: center;
		padding-top: 8px;
		border-top: 1px solid var(--color-border);
		font-size: 0.85rem;
	}

	.tangent-samples:focus-visible {
		outline: 2px solid var(--color-accent-blue);
		outline-offset: 4px;
		border-radius: var(--radius-small);
	}

	.tangent-sample-header,
	.tangent-sample-row {
		display: contents;
	}

	.tangent-sample-header span {
		color: var(--color-text-secondary);
		font-size: 0.8rem;
	}

	.tangent-sample-header span:not(:first-child) {
		text-align: right;
	}

	.tangent-sample-label {
		display: flex;
		align-items: center;
		gap: 6px;
		color: var(--color-text-secondary);
	}

	.direct-tangent-height,
	.hermite-tangent-height,
	.direct-tangent-slope,
	.hermite-tangent-slope {
		color: var(--color-text);
		font-family: monospace;
		text-align: right;
		white-space: nowrap;
	}

	.layer-swatch {
		display: inline-block;
		width: 10px;
		height: 10px;
		flex: 0 0 10px;
		border-radius: 2px;
	}

	.direct-tangent-swatch {
		background: #ff9f43;
	}

	.hermite-tangent-swatch {
		background: #4dc3ff;
	}

	@media (max-width: 650px) {
		.visualization-layout {
			flex-direction: column;
		}

		.viewport {
			box-sizing: border-box;
			width: 100%;
			flex: none;
		}

		.controls {
			box-sizing: border-box;
			width: 100%;
			min-width: 0;
		}
	}
</style>

<script>
	import "../scripts/visualizations/columnSurfaceConstruction.js";
</script>

<div class="column-surface-construction">
	<div class="viewport"></div>

	<div class="controls">
		<label>
			<span class="control-header">
				<span>Surface Variation</span>
				<span class="surface-variation-value">0.00</span>
			</span>

			<input
				class="surface-variation"
				type="range"
				min="-10.0"
				max="10.0"
				step="0.5"
				value="0"
			/>
		</label>

		<label class="visibility-control">
			<input class="toggle-original-surface" type="checkbox" />
			<span>Original Surface</span>
		</label>

		<label class="visibility-control">
			<input class="toggle-corner-samples" type="checkbox" checked />
			<span>Corner Samples</span>
		</label>

		<label class="visibility-control">
			<input class="toggle-bicubic-patch" type="checkbox" checked />
			<span>Bicubic Patch</span>
		</label>

		<label class="visibility-control">
			<input class="toggle-tangent-plane" type="checkbox" checked />
			<span>Tangent Plane</span>
		</label>

		<label class="visibility-control">
			<input class="toggle-gradient-vectors" type="checkbox" />
			<span>Gradient Vectors</span>
		</label>

		<button class="reset-camera"> Reset Camera </button>
	</div>
</div>

<style>
	.column-surface-construction {
		display: flex;
		align-items: flex-start;
		gap: 24px;
	}

	.viewport {
		width: 640px;
		aspect-ratio: 4 / 3;
		overflow: hidden;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-medium);
		background: var(--color-bg);
	}

	.viewport canvas {
		display: block;
		width: 100%;
		height: 100%;
	}

	.controls {
		display: flex;
		flex-direction: column;
		gap: 16px;
		min-width: 220px;
		padding: 1rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-medium);
		background: var(--color-panel);
		color: var(--color-text-secondary);
	}

	.controls label {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.control-header {
		display: flex;
		justify-content: space-between;
		gap: 12px;
		color: var(--color-text);
	}

	.controls input[type="range"] {
		width: 100%;
		margin: 0;
		accent-color: var(--color-accent-blue);
		cursor: pointer;
	}

	.controls button {
		border: 1px solid var(--color-border);
		border-radius: var(--radius-small);
		padding: 0.55rem 0.75rem;
		background: var(--color-panel);
		color: var(--color-text);
		font: inherit;
		cursor: pointer;
		transition:
			background 0.15s ease,
			border-color 0.15s ease,
			color 0.15s ease;
	}

	.controls button:hover {
		background: var(--color-panel-hover);
		border-color: var(--color-border-strong);
		color: var(--color-accent-gold);
	}

	.controls button:focus-visible {
		outline: 2px solid var(--color-accent-blue);
		outline-offset: 2px;
	}

	.visibility-control {
		display: flex;
		flex-direction: row !important;
		align-items: center;
		gap: 8px !important;
		color: var(--color-text);
		cursor: pointer;
	}

	.visibility-control input {
		margin: 0;
		accent-color: var(--color-accent-blue);
	}
</style>


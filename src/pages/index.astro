---
import BaseLayout from "../layouts/BaseLayout.astro";

import { getPublishedArticles } from "../lib/articles.js";

const latestArticles = getPublishedArticles().slice(0, 3);

const placeholderCount = Math.max(0, 3 - latestArticles.length);
---

<BaseLayout title="Aaron's Dev Experiments">
	<section class="hero">
		<p class="eyebrow">Graphics / Terrain Experiments / Game Development</p>

		<h1>
			A personal dev lab for documenting experiments, prototypes, and
			technical dead ends.
		</h1>

		<p class="intro">
			A personal technical notebook for the projects and experiments I
			spend my free time working through.
		</p>
	</section>

	<section class="latest-work">
		<h2>Latest Work</h2>

		<div class="article-grid">
			{
				latestArticles.map((article) => (
					<a class="article-card" href={article.href}>
						<p class="article-card__area">{article.area}</p>

						<h3>{article.title}</h3>

						<p>{article.description}</p>

						<span class="article-card__link">Read article →</span>
					</a>
				))
			}

			{
				Array.from({ length: placeholderCount }).map((_, index) => (
					<div class="article-card article-card--placeholder">
						<p class="article-card__area">Future Article</p>

						<h3>
							{index === 0
								? "More experiments coming"
								: "Under Construction"}
						</h3>

						<p>
							{index === 0
								? "Another technical rabbit hole will eventually end up here."
								: "Currently occupied by an idea that has not become an article yet."}
						</p>
					</div>
				))
			}
		</div>
	</section>

	<section class="areas-preview">
		<h2>Technical Areas</h2>

		<div class="area-grid">
			<a class="area-card" href="/areas/terrain-systems">
				<h3>Terrain Systems</h3>

				<p>
					Research into terrain representation, surface construction,
					density fields, topology, and approaches to editable world
					geometry.
				</p>
			</a>

			<a class="area-card" href="/areas/rendering">
				<h3>Rendering</h3>

				<p>
					Experiments with OpenGL rendering, shaders, lighting,
					texturing, camera systems, and visual presentation.
				</p>
			</a>

			<a class="area-card" href="/areas/spatial-world-systems">
				<h3>Spatial & World Systems</h3>

				<p>
					Work on coordinate systems, chunk organization, large-world
					precision, procedural sampling, and spatial relationships.
				</p>
			</a>

			<a class="area-card" href="/areas/tools-debugging">
				<h3>Tools / Debugging</h3>

				<p>
					Debug views, diagnostic overlays, development controls,
					profiling tools, and workflow improvements that support
					experimentation.
				</p>
			</a>
		</div>
	</section>
</BaseLayout>

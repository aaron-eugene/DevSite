---
import BaseLayout from "../layouts/BaseLayout.astro";

import { getPublishedArticles, getPublishedAreaIds } from "../lib/articles.js";

import { technicalAreas } from "../data/technicalAreas.js";

const publishedArticles = getPublishedArticles();

const latestArticles = publishedArticles.slice(0, 3);

const placeholderCount = Math.max(0, 3 - latestArticles.length);

const publishedAreaIds = getPublishedAreaIds(publishedArticles);
---

<BaseLayout title="Aaron's Dev Experiments">
	<section class="hero">
		<p class="eyebrow">Software Development / Systems / Experimentation</p>

		<h1>
			A personal dev lab for documenting projects, prototypes, and
			technical dead ends.
		</h1>

		<p class="intro">
			I share what I'm working on, what I've learned along the way, and
			the occasional problem that turned out to be more interesting than
			expected.
		</p>
	</section>

	<section class="latest-work">
		<h2>Latest Work</h2>

		<div class="article-grid">
			{
				latestArticles.map((article) => (
					<a class="article-card" href={article.href}>
						<p class="article-card__area">{article.area}</p>

						<h3>{article.title}</h3>

						<p>{article.description}</p>

						<span class="article-card__link">Read article →</span>
					</a>
				))
			}

			{
				Array.from({ length: placeholderCount }).map((_, index) => (
					<div class="article-card article-card--placeholder">
						<p class="article-card__area">Future Article</p>

						<h3>
							{index === 0
								? "More experiments coming"
								: "Under Construction"}
						</h3>

						<p>
							{index === 0
								? "Another technical rabbit hole will eventually end up here."
								: "Currently occupied by an idea that has yet to become an article."}
						</p>
					</div>
				))
			}
		</div>
	</section>

	<section class="areas-preview">
		<h2>Technical Areas</h2>

		<div class="area-grid">
			{
				technicalAreas.map((area) => {
					const published = publishedAreaIds.has(area.id);

					const clickable = published || import.meta.env.DEV;

					const CardTag = clickable ? "a" : "div";

					return (
						<CardTag
							class:list={[
								"area-card",
								{ "area-card--placeholder": !published },
							]}
							href={clickable ? area.href : undefined}
						>
							<h3>{area.title}</h3>

							<p>{area.description}</p>
						</CardTag>
					);
				})
			}
		</div>
	</section>
</BaseLayout>

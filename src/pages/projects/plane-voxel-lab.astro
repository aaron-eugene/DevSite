---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Plane Voxel Lab | Aaron's Dev Experiments">
	<section class="project-header">
		<p class="eyebrow">Project</p>

		<h1>Plane Voxel Lab</h1>

		<p class="intro">
			An experimental C++ / OpenGL lab for investigating voxel terrain
			representation, surface construction, rendering, spatial systems,
			and approaches to editable terrain.
		</p>
	</section>

	<section class="project-section">
		<h2>About the Project</h2>

		<p>
			Plane Voxel Lab is a long-running research project built around a
			series of terrain and graphics experiments. The goal is not to
			commit to one terrain representation immediately, but to explore
			different approaches, understand their tradeoffs, and document what
			works and what does not.
		</p>
	</section>

	<section class="project-section">
		<h2>Technical Areas</h2>

		<div class="project-area-links">
			<a href="/areas/terrain-systems">Terrain Systems</a>
			<a href="/areas/rendering">Rendering</a>
			<a href="/areas/spatial-world-systems">Spatial & World Systems</a>
			<a href="/areas/tools-debugging">Tools / Debugging</a>
		</div>
	</section>

	<section class="project-section">
		<h2>Articles</h2>

		<div class="article-list">
			<a class="article-card" href="/articles/xz-columnar-terrain">
				<p class="article-meta">Terrain Systems</p>

				<h3>XZ Columnar Terrain</h3>

				<p>
					An experiment in constructing a sealed voxel-owned terrain
					surface from heightmap-derived planar patches and vertical
					side fragments.
				</p>
			</a>

			<a class="article-card" href="/articles/large-world-coordinates">
				<p class="article-meta">Spatial & World Systems</p>

				<h3>Large-World Coordinates</h3>

				<p>
					Designing a coordinate system that preserves large-scale
					world placement without sacrificing local floating-point
					precision.
				</p>
			</a>
		</div>
	</section>
</BaseLayout>

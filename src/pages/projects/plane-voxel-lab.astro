---
import BaseLayout from "../../layouts/BaseLayout.astro";

import { getProjectById } from "../../data/projects.js";
import { technicalAreas } from "../../data/technicalAreas.js";

import {
	getPublishedArticles,
	getArticlesByProjectId,
} from "../../lib/articles.js";

const project = getProjectById("plane-voxel-lab");

if (!project) {
	throw new Error("Project 'plane-voxel-lab' not found.");
}

const areas = technicalAreas.filter((area) =>
	project.areaIds.includes(area.id),
);

const articles = getArticlesByProjectId(getPublishedArticles(), project.id);
---

<BaseLayout title={`${project.title} | Aaron's Dev Experiments`}>
	<section class="project-header">
		<p class="eyebrow">Project</p>

		<h1>{project.title}</h1>

		<p class="intro">
			{project.description}
		</p>
	</section>

	<section class="project-section">
		<h2>About the Project</h2>

		<p>
			Plane Voxel Lab is a long-running research project built around a
			series of terrain and graphics experiments. The goal is not to
			commit to one terrain representation immediately, but to explore
			different approaches, understand their tradeoffs, and document what
			works and what does not.
		</p>
	</section>

	<section class="project-section">
		<h2>Technical Areas</h2>

		<div class="related-links">
			{areas.map((area) => <a href={area.href}>{area.title}</a>)}
		</div>
	</section>

	<section class="project-section">
		<h2>Articles</h2>

		<div class="article-list">
			{
				articles.length > 0 ? (
					articles.map((article) => (
						<a class="article-card" href={article.href}>
							<p class="article-meta">{article.area}</p>

							<h3>{article.title}</h3>

							<p>{article.description}</p>

							<span class="article-card__link">
								Read article →
							</span>
						</a>
					))
				) : (
					<p class="empty-state">
						No articles published for this project yet.
					</p>
				)
			}
		</div>
	</section>
</BaseLayout>

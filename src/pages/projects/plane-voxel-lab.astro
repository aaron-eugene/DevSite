---
import BaseLayout from "../../layouts/BaseLayout.astro";

import { getProjectById } from "../../data/projects.js";
import { technicalAreas } from "../../data/technicalAreas.js";

import {
	getPublishedArticles,
	getArticlesByProjectId,
} from "../../lib/articles.js";

const project = getProjectById("plane-voxel-lab");

if (!project) {
	throw new Error("Project 'plane-voxel-lab' not found.");
}

const areas = technicalAreas.filter((area) =>
	project.areaIds.includes(area.id),
);

const articles = getArticlesByProjectId(getPublishedArticles(), project.id);
---

<BaseLayout title={`${project.title} | Aaron's Dev Experiments`}>
	<section class="project-header">
		<p class="eyebrow">Project</p>

		<h1>{project.title}</h1>

		<p class="intro">
			{project.description}
		</p>

		{
			project.repositoryUrl && (
				<p class="project-repository">
					<a
						href={project.repositoryUrl}
						target="_blank"
						rel="noopener noreferrer"
					>
						View source on GitHub ↗
					</a>
				</p>
			)
		}
	</section>

	<section class="project-section">
		<h2>About the Project</h2>

		<p>
			Plane Voxel Lab grew out of an idea for a 3D building and crafting
			game. I wanted a world that could be edited in discrete units, but
			whose terrain didn't look like a collection of cubes.
		</p>

		<p>
			After several refactors in a standalone game project, I decided the
			saner option was to break the terrain work off into its own lab,
			where I could develop each approach as an independent experiment.
			{" "}<em>XZ Columnar Terrain</em>{" "}is one such experiment. This
			gave me room to explore different ideas, understand their tradeoffs,
			and carry useful results forward into future projects.
		</p>
	</section>

	<section class="project-section">
		<h2>Current Direction</h2>

		<p>
			The {" "}<em>XZ Columnar Terrain</em>{" "} experiment is more or less
			complete, but it left me with an idea I want to explore further:
			{" "}<em
				>defining the domain of a surface piece before constructing its
				geometry</em
			>.
		</p>

		<p>
			In the columnar experiment, I partitioned the two-dimensional domain
			of a heightmap into square footprints, then constructed an
			individual terrain piece within each one. This gave the pieces
			predictable boundaries and consistent coverage, even though the
			planar geometry introduced some undesirable artifacts.
		</p>

		<p>
			The next question is whether that idea can be generalized to
			arbitrary three-dimensional surfaces. Although a density field takes
			three spatial coordinates as input, its isosurface is locally
			two-dimensional. That suggests it may be possible to construct
			terrain pieces using local two-dimensional domains oriented to the
			surface, rather than relying on a single global XZ projection.
		</p>

		<p>
			There are some significant problems to solve, particularly how to
			arrange these domains so they cover the surface without unwanted
			gaps or overlaps, and how to handle transitions between different
			orientations. I also want to preserve the separation between surface
			geometry and the underlying voxel structure responsible for
			ownership and editing.
		</p>

		<p>
			For now, time-willing, that's the direction I intend to pursue:
			{" "}<em
				>partitioning an arbitrary continuous surface into individually
				constructible pieces</em
			>, with the goal of producing terrain that retains its natural shape
			while remaining visibly discrete.
		</p>
	</section>

	<section class="project-section">
		<h2>Technical Areas</h2>

		<div class="related-links">
			{areas.map((area) => <a href={area.href}>{area.title}</a>)}
		</div>
	</section>

	<section class="project-section">
		<h2>Articles</h2>

		<div class="article-list">
			{
				articles.length > 0 ? (
					articles.map((article) => (
						<a class="article-card" href={article.href}>
							<p class="article-meta">{article.area}</p>

							<h3>{article.title}</h3>

							<p>{article.description}</p>

							<span class="article-card__link">
								Read article →
							</span>
						</a>
					))
				) : (
					<p class="empty-state">
						No articles published for this project yet.
					</p>
				)
			}
		</div>
	</section>
</BaseLayout>

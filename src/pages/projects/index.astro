---
import BaseLayout from "../../layouts/BaseLayout.astro";

import { projects } from "../../data/projects.js";
---

<BaseLayout title="Projects | Aaron's Dev Experiments">
	<section class="topic-header">
		<p class="eyebrow">What I'm Building</p>

		<h1>Projects</h1>

		<p class="intro">
			Longer-running programming projects that provide the context for the
			experiments, technical notes, and writeups documented on this site.
		</p>
	</section>

	<section class="topic-section">
		<div class="project-list">
			{
				projects.map((project) => (
					<a class="project-card" href={project.href}>
						<h2>{project.title}</h2>

						<p>{project.description}</p>
					</a>
				))
			}
		</div>
	</section>
</BaseLayout>

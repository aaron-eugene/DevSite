---

<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Three.js Test</title>

		<style>
			#visualization {
				display: flex;
				align-items: flex-start;
				gap: 24px;
			}

			#viewport {
				width: 640px;
				aspect-ratio: 4 / 3;
			}

			#controls {
				display: flex;
				flex-direction: column;
				gap: 16px;
				min-width: 220px;
			}

			#controls label {
				display: flex;
				flex-direction: column;
				gap: 6px;
			}

			.control-header {
				display: flex;
				justify-content: space-between;
				gap: 12px;
			}

			#controls input[type="range"] {
				width: 100%;
			}
		</style>
	</head>

	<body>
		<div id="visualization">
			<div id="viewport"></div>

			<div id="controls">
				<label>
					<span class="control-header">
						<span>Plane Offset</span>
						<span id="plane-offset-value">0.00</span>
					</span>

					<input
						id="plane-offset"
						type="range"
						min="-0.87"
						max="0.87"
						step="0.01"
						value="0"
					/>
				</label>

				<label>
					<span class="control-header">
						<span>Azimuth</span>
						<span id="plane-azimuth-value">180°</span>
					</span>

					<input
						id="plane-azimuth"
						type="range"
						min="-180"
						max="180"
						step="1"
						value="180"
					/>
				</label>

				<label>
					<span class="control-header">
						<span>Elevation</span>
						<span id="plane-elevation-value">45°</span>
					</span>

					<input
						id="plane-elevation"
						type="range"
						min="-90"
						max="90"
						step="1"
						value="45"
					/>
				</label>

				<button id="reset-plane"> Reset Plane </button>

				<button id="reset-camera"> Reset Camera </button>

				<div id="intersection-status"></div>
			</div>
		</div>

		<script>
			import "../scripts/visualizations/planeCubeIntersection.js";
		</script>
	</body>
</html>

---
import BaseLayout from "../../layouts/BaseLayout.astro";

import { technicalAreas } from "../../data/technicalAreas.js";

import {
	getPublishedArticles,
	getArticlesByAreaId,
} from "../../lib/articles.js";

/**
 * Generates static pages for each defined technical area.
 *
 * @returns {import("astro").GetStaticPathsResult}
 */
export function getStaticPaths() {
	const publishedArticles = getPublishedArticles();

	return technicalAreas.map((area) => ({
		params: {
			id: area.id,
		},
		props: {
			area,
			articles: getArticlesByAreaId(publishedArticles, area.id),
		},
	}));
}

const { area, articles } = Astro.props;
---

<BaseLayout title={`${area.title} | Aaron's Dev Experiments`}>
	<section class="topic-header">
		<p class="eyebrow">Technical Area</p>

		<h1>{area.title}</h1>

		<p class="intro">
			{area.description}
		</p>
	</section>

	<section class="topic-section">
		<h2>Articles</h2>

		<div class="article-list">
			{
				articles.length > 0 ? (
					articles.map((article) => (
						<a class="article-card" href={article.href}>
							<h3>{article.title}</h3>

							<p>{article.description}</p>

							<span class="article-card__link">
								Read article →
							</span>
						</a>
					))
				) : (
					<p class="empty-state">
						No articles published in this area yet.
					</p>
				)
			}
		</div>
	</section>
</BaseLayout>
